---
import BaseLayout from '../layouts/BaseLayout.astro';

const expertise = [
  {
    title: 'Cloud-Native Architecture',
    text: 'Enterprise architecture across OpenShift, application modernization, Kubernetes platforms, virtualization, multicluster operations and hybrid cloud.'
  },
  {
    title: 'Integration & APIs',
    text: 'API management, event-driven architecture, Kafka, enterprise integration patterns, Camel, gateway standardization and platform modernization.'
  },
  {
    title: 'Software Security',
    text: 'Growing focus on software supply chain security, vulnerability management, cloud-native application security, provenance and secure delivery.'
  }
];

const povs = [
  {
    number: '01',
    title: 'Open Datacenter Modernization',
    text: 'A practical decision framework for infrastructure modernization covering workload assessment, private vs public cloud, migration approaches, TCO, skills, operating model, open-source options and enterprise-supported implementations.',
    tags: ['Datacenter', 'Virtualization', 'Hybrid Cloud', 'Migration'],
    status: 'published',
    published: 'SEPTEMBER 2026',
    href: '/povs/datacenter-modernization/'
  },
  {
    number: '02',
    title: 'Open Data Platform Modernization',
    text: 'A blueprint for evolving data lakes and warehouses toward open, event-driven data platforms with pluggable ingestion, streaming, processing, storage, governance, analytics and AI services.',
    tags: ['Data Lake', 'Data Warehouse', 'Kafka', 'Analytics']
  },
  {
    number: '03',
    title: 'Enterprise AI & GenAI Factory',
    text: 'A repeatable factory model for moving from AI experiments to governed production services across data preparation, model choice, RAG, evaluation, deployment, security, observability and lifecycle management.',
    tags: ['AI', 'GenAI', 'MLOps', 'Governance']
  },
  {
    number: '04',
    title: 'Connected Enterprise: Edge, OT & IT/OT Modernization',
    text: 'A modernization pattern connecting machines, industrial systems, edge platforms and enterprise applications through secure integration, events, APIs, fleet management and distributed computing.',
    tags: ['Edge', 'OT', 'IIoT', 'Integration']
  },
  {
    number: '05',
    title: 'Application Modernization Factory',
    text: 'A structured approach to assess, prioritize and transform application estates using rehost, replatform, refactor, replace and retire patterns with platform engineering and DevSecOps practices.',
    tags: ['Applications', 'Containers', 'DevSecOps', 'Platform Engineering']
  },
  {
    number: '06',
    title: 'Enterprise Integration Modernization',
    text: 'A path from centralized ESB and point-to-point integration toward APIs, events and distributed integration using open standards and interchangeable gateway, messaging and integration technologies.',
    tags: ['API', 'Events', 'Kafka', 'Integration']
  },
  {
    number: '07',
    title: 'Secure Software Factory',
    text: 'A software supply chain blueprint spanning source, CI/CD, SBOM, signing, provenance, policy, registry, deployment and runtime controls with open-source and enterprise security tooling.',
    tags: ['Supply Chain', 'SBOM', 'Provenance', 'Security']
  },
  {
    number: '08',
    title: 'Hybrid & Sovereign Cloud Platform',
    text: 'A common operating model for applications across private datacenters, public cloud and edge with consistent governance, automation, security, lifecycle management and workload portability.',
    tags: ['Hybrid Cloud', 'Sovereignty', 'Multicluster', 'Automation']
  }
];

const speaking = [
  'Enterprise modernization and OpenShift architecture',
  'Developer experience and security',
  'Manufacturing, MES and industrial modernization',
  'Software supply chain and cloud-native security'
];
---
<BaseLayout>
  <header class="site-header">
    <a class="brand" href="#top">SM</a>
    <nav aria-label="Main navigation">
      <a href="#povs">POVs</a>
      <a href="#security">Security</a>
      <a href="#speaking">Speaking</a>
      <a href="#about">About</a>
    </nav>
    <a class="header-cta" href="mailto:sumit.mckv@gmail.com">Connect</a>
  </header>

  <main id="top">
    <section class="hero shell">
      <div class="eyebrow">SOLUTIONS ARCHITECT · CLOUD NATIVE · SECURITY</div>
      <h1>I design platforms that help enterprises <span>modernize with confidence.</span></h1>
      <p class="hero-copy">
        I work at the intersection of cloud-native architecture, application modernization,
        integration, virtualization and software security—turning complex technology choices
        into practical enterprise outcomes.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="#povs">Explore my architecture work</a>
        <a class="button secondary" href="#about">About me</a>
      </div>
      <div class="hero-proof">
        <div><strong>18+</strong><span>Years in technology</span></div>
        <div><strong>Enterprise</strong><span>Architecture & transformation</span></div>
        <div><strong>Security</strong><span>Current strategic focus</span></div>
      </div>
    </section>

    <section class="section shell intro-grid" id="about">
      <div>
        <div class="section-label">01 / PROFILE</div>
        <h2>Architecture beyond the diagram.</h2>
      </div>
      <div class="large-copy">
        <p>
          I am a solutions architect focused on solving enterprise modernization problems—not
          simply selecting products. My work connects infrastructure, applications, APIs,
          integration, security and operations into architectures that can actually be adopted.
        </p>
        <p>
          I am increasingly concentrating my research and hands-on work on software supply chain
          security and cloud-native application security, with the goal of connecting security
          decisions to developer and platform engineering workflows.
        </p>
      </div>
    </section>

    <section class="section shell" id="security">
      <div class="section-heading">
        <div>
          <div class="section-label">02 / EXPERTISE</div>
          <h2>Where I spend my time.</h2>
        </div>
        <p>Three areas that increasingly converge in modern enterprise architecture.</p>
      </div>

      <div class="cards three">
        {expertise.map((item, i) => (
          <article class="card">
            <span class="card-number">0{i + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section shell" id="povs">
      <div class="section-heading">
        <div>
          <div class="section-label">03 / ARCHITECTURE POVs</div>
          <h2>Ideas translated into practical architecture.</h2>
        </div>
        <p>
          Focused points of view and reusable transformation blueprints that begin with the
          customer problem and decision framework before mapping technologies.
        </p>
      </div>

      <div style="display: grid; gap: 24px;">
        <a
          class="featured-pov-card featured-pov-link"
          href="/povs/consent-management/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open From Consent Capture to Enforceable Compliance in a new tab"
        >
          <div>
            <div class="pov-status published">PUBLISHED · SEPTEMBER 2026</div>
            <div class="featured-pov-kicker">INDIA · BANKING · PRIVACY</div>
            <h3>From Consent Capture to Enforceable Compliance</h3>
            <p>
              A practical architecture point of view for Indian banks on turning consent obligations
              into operational decisions, evidence, runtime enforcement and downstream withdrawal propagation.
            </p>
            <div class="tags">
              <span>DPDP</span>
              <span>Banking</span>
              <span>Consent Management</span>
              <span>API Security</span>
              <span>Events</span>
            </div>
          </div>
          <span class="button secondary">Explore the POV ↗</span>
        </a>

        <a
          class="featured-pov-card featured-pov-link"
          href="/povs/8-hour-identity/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open The 8-Hour Identity in a new tab"
        >
          <div>
            <div class="pov-status published">PUBLISHED · SEPTEMBER 2026</div>
            <div class="featured-pov-kicker">IDENTITY SECURITY · ZERO TRUST · JIT ACCESS</div>
            <h3>The 8-Hour Identity</h3>
            <p>
              A practical architecture pattern for giving temporary workers time-bound,
              least-privilege application access without creating permanent enterprise accounts.
            </p>
            <div class="tags">
              <span>Identity Security</span>
              <span>Zero Trust</span>
              <span>JIT Access</span>
              <span>Keycloak</span>
              <span>RBAC / ABAC</span>
            </div>
          </div>
          <span class="button secondary">Explore the POV ↗</span>
        </a>
      </div>

      <div class="blueprint-heading">
        <div class="section-label">OPEN ENTERPRISE MODERNIZATION BLUEPRINTS</div>
        <h3>Long-form decision frameworks for recurring transformation themes.</h3>
      </div>

      <div class="pov-intro">
        <p>
          The objective is not to retrofit a product into every problem. These blueprints are intended
          to help customers and practitioners answer the questions that come before product selection:
          what to modernize, what prerequisites matter, how to migrate, what it may cost, which skills
          are needed, and whether to build, buy or consume the platform as a managed service.
        </p>
      </div>

      <div class="pov-grid">
        {povs.map((pov) => (
          pov.status === 'published' ? (
            <a
              class="pov-card published-pov clickable-pov"
              href={pov.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Open ${pov.title} in a new tab`}
            >
              <div class="pov-number">{pov.number}</div>
              <h3>{pov.title}</h3>
              <p>{pov.text}</p>
              <div class="tags">
                {pov.tags.map((tag) => <span>{tag}</span>)}
              </div>
              <div class="pov-status published">PUBLISHED · {pov.published}</div>
              <div class="tile-link-cue">Open the blueprint ↗</div>
            </a>
          ) : (
            <article class="pov-card">
              <div class="pov-number">{pov.number}</div>
              <h3>{pov.title}</h3>
              <p>{pov.text}</p>
              <div class="tags">
                {pov.tags.map((tag) => <span>{tag}</span>)}
              </div>
              <div class="pov-status">BLUEPRINT · IN DEVELOPMENT</div>
            </article>
          )
        ))}
      </div>
    </section>

    <section class="section shell" id="research">
      <div class="section-heading">
        <div>
          <div class="section-label">04 / RESEARCH & ANALYSIS</div>
          <h2>Security architecture at machine scale.</h2>
        </div>
        <p>Research notes and practitioner analysis on software security, AI, vulnerability management and the software supply chain.</p>
      </div>

      <a class="featured-pov-card research-feature-card" href="/research/cybersecurity-decision-latency/" aria-label="Read Cybersecurity Is Becoming a Decision-Latency Problem">
        <div>
          <div class="pov-status published">PUBLISHED · SEPTEMBER 2026</div>
          <div class="featured-pov-kicker">SECURITY ARCHITECTURE · AI · VULNERABILITY MANAGEMENT</div>
          <h3>Cybersecurity Is Becoming a Decision-Latency Problem</h3>
          <p>
            Why machine-scale security requires better correlation, delegated authority and safer automation—not simply more detection.
          </p>
          <div class="tags">
            <span>Security Architecture</span>
            <span>AI</span>
            <span>Vulnerability Management</span>
            <span>Software Supply Chain</span>
          </div>
        </div>
        <span class="button secondary">Read the analysis →</span>
      </a>
    </section>

    <section class="section shell" id="speaking">
      <div class="section-heading">
        <div>
          <div class="section-label">05 / SPEAKING</div>
          <h2>Topics I speak about.</h2>
        </div>
        <p>I enjoy translating complex architecture into a clear story for technical and business audiences.</p>
      </div>

      <div class="speaking-grid">
        {speaking.map((topic, i) => (
          <div class="speaking-item"><span>0{i + 1}</span><p>{topic}</p></div>
        ))}
      </div>
    </section>

    <section class="section shell connect">
      <div class="section-label">06 / CONNECT</div>
      <h2>Building something around cloud platforms, modernization or software security?</h2>
      <p>I’m interested in architecture conversations, technical collaboration, speaking opportunities and ambitious platform problems.</p>
      <div class="hero-actions">
        <a class="button primary" href="mailto:sumit.mckv@gmail.com">Start a conversation</a>
        <a class="button secondary" href="https://www.linkedin.com/in/sumit-mukherjee" target="_blank">LinkedIn ↗</a>
        <a class="button secondary" href="https://github.com/summu1985" target="_blank">GitHub ↗</a>
      </div>
    </section>
  </main>

  <footer class="shell">
    <span>© {new Date().getFullYear()} Sumit Mukherjee</span>

    <div class="footer-meta">
      <span>Designed as a living professional portfolio.</span>

      <span class="visitor-count" aria-label="Homepage visitor count">
        <span class="visitor-dot"></span>
        <span id="visitor-count">Visitors: —</span>
      </span>
    </div>
  </footer>

  <script
    data-goatcounter="https://summu1985.goatcounter.com/count"
    async
    src="https://gc.zgo.at/count.js">
  </script>

  <script is:inline>
    async function loadVisitorCount() {
      const counter = document.getElementById('visitor-count');
      if (!counter) return;

      try {
        const response = await fetch(
          'https://summu1985.goatcounter.com/counter/%2F.json'
        );

        if (!response.ok) {
          throw new Error(`Counter request failed: ${response.status}`);
        }

        const data = await response.json();
        counter.textContent = `Visitors: ${data.count}`;
      } catch (error) {
        console.warn('Unable to load visitor count.', error);
        counter.textContent = 'Visitors';
      }
    }

    loadVisitorCount();
  </script>

  <style>
    .clickable-pov {
      display: block;
      cursor: pointer;
    }

    .clickable-pov:hover {
      transform: translateY(-3px);
    }

    .tile-link-cue {
      margin-top: 16px;
      color: var(--accent);
      font-weight: 650;
      font-size: 14px;
    }

    .research-feature-card {
      margin-bottom: 0;
      cursor: pointer;
      transition: border-color 180ms ease, background-color 180ms ease, transform 180ms ease;
    }

    .research-feature-card:hover {
      transform: translateY(-3px);
      border-color: rgba(139, 224, 192, .7);
    }
  
    /* Featured architecture POV tiles: whole-card interaction */
    .featured-pov-link {
      cursor: pointer;
      transition:
        transform 180ms ease,
        border-color 180ms ease,
        background 180ms ease,
        box-shadow 180ms ease;
    }

    .featured-pov-link:hover {
      transform: translateY(-3px);
      border-color: var(--accent) !important;
      background:
        linear-gradient(
          135deg,
          rgba(139, 224, 192, .22),
          rgba(139, 224, 192, .07)
        ),
        var(--panel-2) !important;
      box-shadow: 0 12px 28px rgba(0, 0, 0, .08);
    }

    .featured-pov-link:focus-visible {
      outline: 3px solid rgba(0, 122, 94, .22);
      outline-offset: 4px;
    }

    .featured-pov-link .button.secondary {
      pointer-events: none;
    }

  </style>
</BaseLayout>
