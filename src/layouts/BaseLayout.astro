---
import '../styles/global.css';
const { title = 'Sumit Mukherjee', description = 'Solutions Architect focused on cloud-native platforms, integration, virtualization, and software security.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2f2f2" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
